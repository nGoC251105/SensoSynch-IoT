          "name": "19 - LED1 ON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/devices/1/control",
            "description": "Cần ESP32 online. Sau khi gửi, sử dụng 25 - Action result để xác minh SUCCESS.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ON\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
                  "if (pm.response.code === 202) { const result = pm.response.json(); if (result.id) pm.collectionVariables.set(\"actionId\", String(result.id)); }"
                ]
              }
            }
